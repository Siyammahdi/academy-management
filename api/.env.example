# Copy this file to `.env` and fill in real values for your machine.
# `.env` is git-ignored; never commit real secrets.
#
# See docs/05-database-design.md §2.1 for how Prisma 7 reads DATABASE_URL,
# and docs/07-architecture.md §9 for what each of these is for.

# ── Server ────────────────────────────────────────────────────────────────
# 4000, not 3000 — Next.js's `next dev` also defaults to 3000. Pinning the
# API to a different port here removes the collision entirely; see the
# root README's "Getting started" for the full explanation.
PORT=4000

# The frontend's origin — used for CORS (src/main.ts) so the browser can
# call this API cross-origin when not using the Next.js same-origin proxy.
WEB_URL="http://localhost:3001"

# Optional comma-separated extra origins (preview deploys, custom domains).
# Example: CORS_ORIGINS="https://preview.vercel.app,https://annahda.academy"
# CORS_ORIGINS=

# In non-production, LAN origins (http://192.168.x.x:3001) are also allowed
# so you can test the web app from a phone on the same Wi‑Fi.

# ── Database (Prisma 7 driver adapter — prisma.config.ts reads this) ──────
# Matches docker-compose.yml's Postgres service.
DATABASE_URL="postgresql://nahda:nahda_dev_password@localhost:5432/nahda?schema=public"

# ── Redis (BullMQ background jobs — see src/jobs/) ─────────────────────────
# Matches docker-compose.yml's Redis service.
REDIS_URL="redis://localhost:6379"

# ── Auth (required — src/modules/auth/jwt.config.ts fails fast if unset) ──
# Generate distinct random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-random-64-char-hex-string"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-char-hex-string"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── SSLCommerz payment gateway (src/modules/gateway/sslcommerz.gateway.ts) ─
# Sandbox demo store — replace with your own merchant credentials for live.
# Merchant panel: https://sandbox.sslcommerz.com/manage/
# Session API:    https://sandbox.sslcommerz.com/gwprocess/v4/api.php
# Validation API: https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
#
# SSLCommerz often requires success/fail/cancel/IPN URLs to match the store's
# Registered URL. Localhost may be rejected — use a public tunnel (ngrok) and
# set APP_URL / API_URL to that origin, then register the IPN in the panel:
#   {API_URL}/api/v1/webhooks/sslcommerz
SSLCOMMERZ_STORE_ID="china6a3584e27fe03"
SSLCOMMERZ_STORE_PASSWORD="china6a3584e27fe03@ssl"
SSLCOMMERZ_IS_SANDBOX=true

# ── PayStation payment gateway (src/modules/gateway/paystation.gateway.ts) ─
# Default online provider for new checkouts. Swap BASE_URL + credentials to
# go live — no code changes.
#
# Environments:
#   Sandbox: https://sandbox.paystation.com.bd
#   Live:    https://api.paystation.com.bd
# Do NOT use sandbox-api.paystation.com.bd — that hostname does not resolve.
#
# Sandbox demo merchant (from PayStation docs/SDK) — replace for production.
# Register PAYSTATION_CALLBACK_URL in the merchant panel:
#   {APP_URL}/payments/paystation-return
PAYSTATION_BASE_URL="https://sandbox.paystation.com.bd"
PAYSTATION_MERCHANT_ID="104-1653730183"
PAYSTATION_PASSWORD="gamecoderstorepass"
PAYSTATION_CALLBACK_URL="http://localhost:3001/payments/paystation-return"

# Used to build the gateway's redirect URLs (APP_URL) and IPN webhook URL
# (API_URL) — bare origins, no path or trailing slash. Must match wherever
# `web`/`api` actually run for the gateway round-trip to work at all.
APP_URL="http://localhost:3001"
API_URL="http://localhost:3000"

# ── Email (src/modules/mail/ + email/) ─────────────────────────────────────
# Transport priority: SMTP_* → RESEND_API_KEY → console logger (dev).
# Messages are enqueued on BullMQ `email-dispatch`.
#
# PRODUCTION: you MUST run a second process that consumes the queue:
#   pnpm start:worker:prod   # after `pnpm build` → node dist/src/worker.js
# The HTTP API alone never sends mail — without the worker, jobs sit in Redis.
# Put the SAME REDIS_URL, RESEND_API_KEY, and MAIL_FROM on both API and worker.
# Redis on Render/Upstash often uses rediss:// (TLS) — that is supported.
#
# SMTP (optional — production-friendly)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM_EMAIL="noreply@annahda.academy"
# SMTP_FROM_NAME="An Nahda Academy"
#
# Resend (optional)
# RESEND_API_KEY=""
# MAIL_FROM must be `email@domain` or `Name <email@domain>` — never bare `<email>`.
# MAIL_FROM="An Nahda Academy <onboarding@resend.dev>"
# With onboarding@resend.dev (no verified domain), Resend only delivers to the
# email on your Resend account. Verify a domain at https://resend.com/domains
# before using a custom From like noreply@yourdomain.com — otherwise sends 403.
#
# OTP / email verification (src/modules/otp/)
# OTP_EXPIRY_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5

# ── Seed script (api/prisma/seed.ts) — optional, has built-in defaults ────
# SEED_ADMIN_EMAIL="admin@nahda.local"
# SEED_ADMIN_PASSWORD="ChangeMe123!"
