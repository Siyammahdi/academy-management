# Browser-facing API base. Prefer the same-origin path so phones never call
# `localhost` (on a phone that means the phone itself — login fails).
NEXT_PUBLIC_API_URL=/api/v1

# Nest origin for Next.js rewrites (no /api/v1 suffix). Local example:
API_PROXY_TARGET=http://127.0.0.1:4000

# On Vercel, set API_PROXY_TARGET to your public Nest URL, e.g.
# API_PROXY_TARGET=https://api.your-domain.com
# Keep NEXT_PUBLIC_API_URL=/api/v1 so the browser stays same-origin.
